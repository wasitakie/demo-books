# Optional: without these values the site displays clearly labelled demo books.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_RANGE=Books!A1:Z1000
# Optional: numeric gid from the URL. When set, resolves the tab name automatically.
# Use GOOGLE_SHEET_RANGE=A1:Z1000 with this setting.
GOOGLE_SHEET_GID=

# Build-time path prefix; leave empty locally or for a custom domain.
NEXT_PUBLIC_BASE_PATH=

# Optional: HTTPS shop URL used when a book has no buy_url.
SHOP_ORDER_URL=

# Contact options shown in the footer and for books without a purchase link.
SHOP_FACEBOOK_URL=
SHOP_LINE_URL=
SHOP_EMAIL=
